<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="OutTuna.Dota2CFGChanger"
    version="1.0.0.0"
    processorArchitecture="*"
  />

  <description>Dota 2 Config Manager — переносит конфиги Dota 2 между Steam-аккаунтами</description>

  <!-- Run with the invoking user's own privileges; the app only ever
       touches files under Steam's userdata folder and its own settings
       directory, so it has no reason to ask for elevation. Requesting
       admin rights unnecessarily is itself a heuristic red flag for some
       AV engines ("why does a config copier want admin?"). -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Per-monitor DPI awareness, so the ImGui UI renders crisp instead of
       blurry/upscaled on high-DPI displays. -->
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- Declare compatibility with modern Windows so the OS doesn't apply
       legacy compatibility shims (another thing that can look odd to
       heuristic scanners on an otherwise plain, modern app). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /> <!-- Windows 10/11 -->
    </application>
  </compatibility>
</assembly>
