// Auto-configured by CMake (configure_file) from app.rc.in -- do not edit
// the generated copy directly, edit this template instead.
//
// A .exe with no icon, no manifest and no VERSIONINFO at all (just raw
// code) is itself a small heuristic signal to some AV engines -- "real"
// applications almost always carry this metadata; its total absence is
// common in hastily-assembled malware droppers. None of this guarantees
// avoiding a false positive, but it's a legitimate, low-cost signal to add.

#include <winresrc.h>

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/Icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_SOURCE_DIR@/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,0,0
 PRODUCTVERSION  @APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OutTuna"
            VALUE "FileDescription",  "Dota 2 Config Manager -- переносит конфиги Dota 2 между Steam-аккаунтами"
            VALUE "FileVersion",      "@APP_VERSION_STRING@"
            VALUE "InternalName",     "DotaManager"
            VALUE "OriginalFilename", "DotaManager.exe"
            VALUE "ProductName",      "Dota 2 Config Manager"
            VALUE "ProductVersion",   "@APP_VERSION_STRING@"
            VALUE "LegalCopyright",   "OutTuna"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
