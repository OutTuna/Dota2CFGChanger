+            cpr::ProgressCallback{[](cpr::cpr_pf_arg_t, cpr::cpr_pf_arg_t, cpr::cpr_pf_arg_t, cpr::cpr_pf_arg_t, intptr_t) { return !stopping.load(); }});
+        if (!stopping.load() && response.status_code == 200 && response.error.code == cpr::ErrorCode::OK)
