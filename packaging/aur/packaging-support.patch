+name: Core sanitizers
+
+on:
+  push:
+    branches: [alpha]
+  pull_request:
+    paths:
+      - 'CMakeLists.txt'
+      - 'cmake/**'
+      - 'src/**'
+      - 'tests/**'
+      - 'resources/**'
+      - '.github/workflows/sanitizers.yaml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  address-undefined:
+    runs-on: ubuntu-22.04
+    timeout-minutes: 20
+    env:
+      ASAN_OPTIONS: detect_leaks=1
+      UBSAN_OPTIONS: halt_on_error=1:print_stacktrace=1
+    steps:
+      - uses: actions/checkout@v7.0.1
+      - name: Install build dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            build-essential cmake libgl1-mesa-dev libx11-dev libxrandr-dev \
+            libxinerama-dev libxcursor-dev libxi-dev libssl-dev
+      - name: Configure sanitizers
+        run: |
+          cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DDOTAMANAGER_BUILD_TESTS=ON \
+            '-DCMAKE_C_FLAGS=-fsanitize=address,undefined -fno-omit-frame-pointer' \
+            '-DCMAKE_CXX_FLAGS=-fsanitize=address,undefined -fno-omit-frame-pointer'
+      - name: Build
+        run: cmake --build build --parallel 2
+      - name: Regression and fault-injection tests
+        env:
+          CXXFLAGS: -fsanitize=address,undefined -fno-omit-frame-pointer
+        run: |
+          ctest --test-dir build --output-on-failure
+          python3 tests/core_checks.py build/_deps/json-src/include
