+namespace {
+std::atomic<int> wakes{0};
+void wake() { ++wakes; }
+std::mutex scan_mutex;
+std::condition_variable scan_finished;
+void scan_wake() {
+    std::lock_guard<std::mutex> lock(scan_mutex);
+    ui_events::dirty = false;
+    scan_finished.notify_all();
+}
+}
